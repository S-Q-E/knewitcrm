# Step 0 temporary protection (removed in step 2)
CRM_BASIC_USER=admin
CRM_BASIC_PASS=change-me

# Step 1 backend skeleton
DATABASE_URL=postgresql://knewit:knewit@localhost:5432/knewit
SECRET_KEY=change-me-to-a-long-random-string
APP_ENV=local
COOKIE_SECURE=false
ALLOWED_ORIGINS=
DEFAULT_TIMEZONE=Asia/Almaty
DEFAULT_CURRENCY=KZT
LOG_LEVEL=INFO
# Optional Postgres parts, used only when DATABASE_URL is empty
# PGHOST=localhost
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=
# PGDATABASE=railway
