# Step 1 backend skeleton
DATABASE_URL=postgresql://knewit:knewit@localhost:5432/knewit
SECRET_KEY=change-me-to-a-long-random-string
APP_ENV=local
COOKIE_SECURE=false
ALLOWED_ORIGINS=
DEFAULT_TIMEZONE=Asia/Almaty
DEFAULT_CURRENCY=KZT
LOG_LEVEL=INFO
# Step 2 bootstrap: used once to create the first admin (min 10 chars), then ignored
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Step 3 bot sync worker (asyncio task in lifespan, advisory-locked)
SYNC_ENABLED=true
SYNC_INTERVAL_SECONDS=5
# Step 9C background workers: each has its own kill switch (all on by default)
OUTBOX_ENABLED=true
NOTIFICATIONS_ENABLED=true
REALTIME_ENABLED=true
# Step 9B manager outbox: n8n webhook that actually sends WhatsApp messages
N8N_SEND_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=
OUTBOX_INTERVAL_SECONDS=5
# Auth: how many trailing X-Forwarded-For entries are appended by trusted
# proxies (outermost last). 1 = single proxy (Railway); 0 = direct, ignore XFF.
TRUSTED_PROXY_HOPS=1
# Step 14 hardening: per-IP sliding window over all /api traffic (login keeps
# its own stricter rules); manager sends are limited per user.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=600
RATE_LIMIT_SEND_PER_MINUTE=30
# Step 14 hardening: reject request bodies above this size (413).
MAX_REQUEST_BODY_BYTES=10485760
# Step 14 observability: Prometheus metrics at /api/metrics (Bearer token).
# Empty = endpoint answers 404.
METRICS_TOKEN=
# Step 14 observability: optional Sentry (backend + frontend via VITE_SENTRY_DSN).
SENTRY_DSN=
SENTRY_ENVIRONMENT=
# Step 14 hardening: graceful worker shutdown bound + asyncpg pool limits.
SHUTDOWN_TIMEOUT_SECONDS=10
DB_POOL_SIZE=5
DB_POOL_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30
# Optional Postgres parts, used only when DATABASE_URL is empty
# PGHOST=localhost
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=
# PGDATABASE=railway
# PGSSL=
