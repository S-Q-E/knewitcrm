# Step 1 backend skeleton
DATABASE_URL=postgresql://knewit:knewit@localhost:5432/knewit
SECRET_KEY=change-me-to-a-long-random-string
APP_ENV=local
COOKIE_SECURE=false
ALLOWED_ORIGINS=
DEFAULT_TIMEZONE=Asia/Almaty
DEFAULT_CURRENCY=KZT
LOG_LEVEL=INFO
# Step 2 bootstrap: used once to create the first admin (min 10 chars), then ignored
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Step 3 bot sync worker (asyncio task in lifespan, advisory-locked)
SYNC_ENABLED=true
SYNC_INTERVAL_SECONDS=5
# Auth: how many trailing X-Forwarded-For entries are appended by trusted
# proxies (outermost last). 1 = single proxy (Railway); 0 = direct, ignore XFF.
TRUSTED_PROXY_HOPS=1
# Optional Postgres parts, used only when DATABASE_URL is empty
# PGHOST=localhost
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=
# PGDATABASE=railway
# PGSSL=
