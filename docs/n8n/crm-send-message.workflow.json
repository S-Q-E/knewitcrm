    {
      "parameters": {
        "method": "POST",
        "url": "=https://whatsapp-provider.example.local/send",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
