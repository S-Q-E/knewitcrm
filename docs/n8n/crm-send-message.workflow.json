        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"to\": \"{{ $json.whatsapp_id }}\",\n  \"text\": \"{{ $json.text }}\",\n  \"client_reference\": \"{{ $json.outbox_id }}\"\n}",
        "options": {
          "timeout": 10000,
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "id": "77777777-7777-4777-8777-777777777777",
      "name": "Send via WhatsApp (REPLACE)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1120,
        300
      ],
      "onError": "continueErrorOutput",
      "notes": "REPLACE this node with the same WhatsApp provider node used in the main bot workflow (same credentials, same API). Keep the input fields whatsapp_id/text/outbox_id and return provider_message_id."
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO n8n_processed_outbox (outbox_id, provider_message_id) VALUES ('{{ $('Check Duplicate').first().json.outbox_id }}'::uuid, '{{ $json.provider_message_id }}') ON CONFLICT (outbox_id) DO NOTHING",
        "options": {}
      },
