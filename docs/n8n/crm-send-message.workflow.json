            {
              "id": "cond-secret-nonempty",
              "leftValue": "={{ $json.headers[\"x-crm-secret\"] }}",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            },
            {
              "id": "cond-secret",
              "leftValue": "={{ $json.headers[\"x-crm-secret\"] }}",
              "rightValue": "={{ $env.N8N_WEBHOOK_SECRET }}",
              "operator": {
                "type": "string",
                "operation": "equals"
